            givemon(SPECIES_CRABOMINABLE,65,ITEM_LIFE_ORB,ITEM_POKE_BALL,NATURE_ADAMANT,1,0,252,252,0,0,0,4,31,31,31,31,31,31,MOVE_ICE_HAMMER,MOVE_EARTHQUAKE,MOVE_CLOSE_COMBAT,MOVE_THUNDER_PUNCH,2,FALSE,TYPE_FIGHTING,10)
