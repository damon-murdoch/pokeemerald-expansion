            goto(Auto_EventScript_Sample_Sets_Doubles_Azelf_Page1)
        case MULTI_R_PRESSED:
            goto(Auto_EventScript_Sample_Sets_Doubles_Azelf_Page1)
        default:
            goto(Auto_EventScript_Sample_Sets_Doubles_Page7)
    }
}

