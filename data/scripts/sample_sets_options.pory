    multichoice2(0,0,Auto_Text_Sample_Sets_Doubles_Gengar_Page1)
    switch(var(VAR_RESULT))
    {
        case 0: # 4/0-/0/252/0/252+
            givemon(SPECIES_GENGAR,65,ITEM_FOCUS_SASH,ITEM_POKE_BALL,NATURE_TIMID,0,0,4,0,0,252,252,0,31,0,31,31,31,31,MOVE_SHADOW_BALL,MOVE_SLUDGE_BOMB,MOVE_PROTECT,MOVE_ICY_WIND,2,FALSE,TYPE_STELLAR,10)
            goto(Common_EventScript_Sample_Sets_CheckPurchase)
        case 1: # 4/0-/0/252/0/252+ (MEGA)
            givemon(SPECIES_GENGAR,65,ITEM_GENGARITE,ITEM_POKE_BALL,NATURE_TIMID,0,0,4,0,0,252,252,0,31,0,31,31,31,31,MOVE_PROTECT,MOVE_SLUDGE_BOMB,MOVE_SHADOW_BALL,MOVE_SUBSTITUTE,2,FALSE,TYPE_STELLAR,10)
            goto(Common_EventScript_Sample_Sets_CheckPurchase)
        case MULTI_L_PRESSED:
            goto(Auto_EventScript_Sample_Sets_Doubles_Gengar_Page1)
        case MULTI_R_PRESSED:
            goto(Auto_EventScript_Sample_Sets_Doubles_Gengar_Page1)
        default:
            goto(Auto_EventScript_Sample_Sets_Doubles_Page40)
    }
}

