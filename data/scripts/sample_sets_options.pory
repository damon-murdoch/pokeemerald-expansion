    switch(var(VAR_RESULT))
    {
        case 0: # 4/252/0/0-/0/252+
            givemon(SPECIES_AZELF,65,ITEM_CHOICE_BAND,ITEM_POKE_BALL,NATURE_JOLLY,0,0,4,252,0,252,0,0,31,31,31,31,31,31,MOVE_EXPLOSION,MOVE_U_TURN,MOVE_ZEN_HEADBUTT,MOVE_KNOCK_OFF,2,FALSE,TYPE_NORMAL,10)
            goto(Common_EventScript_Sample_Sets_CheckPurchase)
