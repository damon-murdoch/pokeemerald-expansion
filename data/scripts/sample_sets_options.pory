            givemon(SPECIES_YVELTAL,65,ITEM_LIFE_ORB,ITEM_POKE_BALL,NATURE_JOLLY,0,0,4,252,0,252,0,0,31,31,31,31,31,31,MOVE_FOUL_PLAY,MOVE_SUCKER_PUNCH,MOVE_KNOCK_OFF,MOVE_PROTECT,2,FALSE,TYPE_POISON,10)
