            givemon(SPECIES_AGGRON,65,ITEM_AGGRONITE,ITEM_POKE_BALL,NATURE_ADAMANT,0,1,252,252,0,0,0,4,31,31,31,31,31,31,MOVE_HEAVY_SLAM,MOVE_ICE_PUNCH,MOVE_EARTHQUAKE,MOVE_FIRE_PUNCH,2,FALSE,TYPE_WATER,10)
            goto(Common_EventScript_Sample_Sets_CheckPurchase)
        case MULTI_L_PRESSED:
            goto(Auto_EventScript_Sample_Sets_Singles_Aggron_Page1)
        case MULTI_R_PRESSED:
            goto(Auto_EventScript_Sample_Sets_Singles_Aggron_Page1)
        default:
            goto(Auto_EventScript_Sample_Sets_Singles_Page1)
    }
}

script Auto_EventScript_Sample_Sets_Singles_Alakazam_Page1
